{
  "manifest_version": 3,
  "name": "Print Picker",
  "version": "1.0.0",
  "description": "在页面上选取任意元素，按 ↑ 选上级、Enter 确认，只把选中的内容交给浏览器打印。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "选取要打印的区域",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "minimum_chrome_version": "100"
}
